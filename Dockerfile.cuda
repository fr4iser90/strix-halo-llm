# CUDA build of llama-server / llama-bench (NVIDIA hosts).
#
# Prep source (same pin as Vulkan/Nix path):
#   ./scripts/fetch-llama.sh
#
# Build:
#   docker build -f Dockerfile.cuda -t llama-cpp-cuda:latest .
#
# Needs NVIDIA Container Toolkit on the host:
#   https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/install-guide.html
#
# Default base is CUDA 12.4 devel on Ubuntu 22.04 — override if needed:
#   docker build -f Dockerfile.cuda --build-arg CUDA_IMAGE=nvidia/cuda:12.2.2-devel-ubuntu22.04 …

ARG CUDA_IMAGE=nvidia/cuda:12.4.1-devel-ubuntu22.04
FROM ${CUDA_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake ninja-build build-essential \
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
# Host-cloned tree (Docker build often cannot git-clone GitHub on restricted hosts).
# Prepare with: ./scripts/fetch-llama.sh
COPY .build/llama.cpp /workspace/llama.cpp
WORKDIR /workspace/llama.cpp

RUN cmake -S . -B build -G Ninja \
      -DGGML_CUDA=ON \
      -DGGML_NATIVE=OFF \
      -DCMAKE_BUILD_TYPE=Release \
 && cmake --build build -j"$(nproc)" --target llama-server llama-bench \
 && install -d /usr/local/bin \
 && install -m755 build/bin/llama-server build/bin/llama-bench /usr/local/bin/

# Runtime image keeps the same tag for compose simplicity (devel base is large but reliable).
# Slimmer multi-stage can be added later if needed.
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

EXPOSE 8080
CMD ["llama-server", "--host", "0.0.0.0", "--port", "8080"]
