#!/usr/bin/env bash
# Single root entry for all benchmarks.
#   ./bench                  interactive
#   ./bench throughput …     llama-bench PP/TG (output/bench/throughput)
#   ./bench sched …          rolling prefill / slots (output/bench/scheduling)
#   ./bench quality …        task correctness (HumanEval, …)
#   ./bench capacity …       KV×ctx + dual-256k (bench profile, stickys untouched)
#   ./bench matrix …         multi-suite matrix (default|full profiles)
#   ./bench publish          copy curated HTML → docs/ (GitHub Pages)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Load project .env so GPU_POWER=true etc. apply to ./bench (compose already reads .env).
if [[ -f "$ROOT/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$ROOT/.env"
  set +a
fi

THROUGHPUT="$ROOT/tools/bench/throughput/run.sh"
SCHED="$ROOT/tools/bench/scheduling/run.sh"
QUALITY="$ROOT/tools/bench/quality/run.sh"
CAPACITY="$ROOT/tools/bench/capacity/run.sh"
HALOGEN="$ROOT/tools/bench/halogen/run.sh"
MATRIX="$ROOT/tools/bench/matrix/run.sh"
SYNC_MODELS="$ROOT/tools/bench/sync-models-from-disk.sh"
APPLY_INI="$ROOT/tools/bench/apply-ini.sh"
BUILD_INDEX="$ROOT/tools/bench/build-index.sh"
PUBLISH_DOCS="$ROOT/tools/bench/publish-docs.sh"
SMOKE="$ROOT/tools/bench/smoke.sh"
AUDIO="$ROOT/tools/bench/audio/run.sh"

[[ -x "$THROUGHPUT" ]] || chmod +x "$THROUGHPUT" 2>/dev/null || true
[[ -x "$SCHED" ]] || chmod +x "$SCHED" 2>/dev/null || true
chmod +x "$ROOT"/tools/bench/scheduling/scenarios/*.sh "$ROOT"/tools/bench/scheduling/lib/*.sh 2>/dev/null || true
chmod +x "$CAPACITY" "$ROOT"/tools/bench/capacity/scenarios/*.sh 2>/dev/null || true
chmod +x "$ROOT"/tools/bench/capacity/lib/*.sh 2>/dev/null || true
chmod +x "$MATRIX" 2>/dev/null || true

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: ./bench [command] [options]

Commands:
  (none) | interactive     goal-based menu (best for first runs)
  recipes | goals          print “what to run” cheat sheet
  smoke                    multi-engine HTTP health (all engines)
  audio                    Piper latency / Whisper RTF (--engine piper|whisper)
  throughput | thr | t     PP/TG (llama native or --engine halogen-flash|gufo)
  sched | scheduling | s   load latency (llama; dual_llm = two llama routers, optional)
  quality | q              HumanEval (--engine for HTTP LLMs)
  capacity | cap           memory fit (llama · http for halogen/gufo)
  halogen | halo           Halogen Flash full matrix (compat → matrix --engine)
  matrix | m               multi-suite (--engine llama.cpp|halogen-flash|gufo|piper|whisper)
  sync-models              scan MODELS_DIR → lab/emb/extractor INIs
  list | compare | compare-sched | apply-ini | index | publish | probe-host
  help                     this help

Stack (any engines):
  ./stack up [llama,halogen,gufo,piper,whisper]
  ./stack status

Quick recipes:
  ./stack up llama,piper,whisper && ./bench smoke
  ./bench audio --engine piper,whisper
  ./bench matrix --engine halogen-flash
  ./bench matrix --engine piper
  ./bench throughput --vulkan -m Qwen3.6

See: tools/bench/README.md · engines/README.md
EOF
}

print_recipes() {
  cat <<'EOF'
Bench recipes — pick a goal (you do NOT need every suite)

  A. Fastest model (PP/TG tok/s)     ~5–30 min
     ./bench throughput --vulkan -m PATTERN [-m PATTERN …]
     (default suite: models-bench.ini; stickys stopped)

  B. Sticky feel (np / ub under load)  ~1–4 h per model
     SCHED_MODEL=SECTION_NAME ./bench sched --auto
     (bench-a :11601 — stickys stopped then restored)

  B2. Two llama LLMs at once (dual_llm / coexist_capacity)
     ONLY sticky chat + lab/coder under KV/GTT load — NOT piper/whisper/halogen.
     COEXIST_CHAT_MODEL=… COEXIST_CODER_MODEL=… ./bench sched --scenario dual_llm

  Multi-engine stack health (not a load bench):
     ./stack up llama,piper,whisper && ./bench smoke

  C. Max context solo (does it fit?)   ~1–8 h
     ./bench capacity kv-ctx --from coder,chat,lab --model NAME[,NAME…]
     (bench-a :11601 — sticky INIs untouched)

  D. Two stickys fit? (dual)           ~2–12 h — OPTIONAL
     Only if you want chat+coder concurrent / have ≥~64 GiB RAM:
     ./bench capacity dual --from coder,chat,lab --model NAME[,NAME…]

  E. Code quality (HumanEval)          ~0.5–3 h per model
     ./bench quality humaneval --model SECTION --limit 20

  F. Full matrix                       multi-day
     Solo capacity + sched + throughput + HumanEval (no dual).
     ./bench matrix --profile full [--model …] [--no-vl]
     Dual separately if needed: ./bench capacity dual …  (or --profile default)
     tmux new -s bench './bench matrix --profile full --model …'

Routers / engines:
  llama sticky/coder  :11535 / :11538
  llama lab           :11537   (dual_llm scenario)
  llama bench-a/b     :11601 / :11602
  halogen / gufo      :8731 / :8080
  whisper / piper     :9000 / :9001

Interactive:  ./bench
EOF
}

read_tty() {
  local _var="$1" _prompt="$2"
  if [[ -r /dev/tty ]]; then
    read -r -p "$_prompt" "$_var" </dev/tty
  elif [[ -t 0 ]]; then
    read -r -p "$_prompt" "$_var"
  else
    die "interactive mode needs a terminal. Try: ./bench throughput --help"
  fi
}

pick() {
  local prompt="$1"; shift
  local -a opts=("$@")
  local i choice default=1
  { echo ""; echo "$prompt"; } >&2
  for i in "${!opts[@]}"; do
    printf '  %d) %s\n' "$((i + 1))" "${opts[$i]}" >&2
  done
  read_tty choice "Choice [${default}]: "
  choice="${choice:-$default}"
  [[ "$choice" =~ ^[0-9]+$ ]] || die "invalid choice: $choice"
  (( choice >= 1 && choice <= ${#opts[@]} )) || die "invalid choice: $choice"
  printf '%s\n' "${opts[$((choice - 1))]}"
}

map_shorthand() {
  local args=()
  local suite_set=0 backend_set=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      bench) args+=(--bench); suite_set=1 ;;
      daily) args+=(--daily); suite_set=1 ;;
      lab|heavy) args+=(--lab); suite_set=1 ;;
      all)
        if [[ "$suite_set" -eq 0 && "$backend_set" -eq 0 ]]; then
          args+=(--all); suite_set=1
        else
          args+=(--all-backends); backend_set=1
        fi
        ;;
      mix) args+=(--bench --daily); suite_set=1 ;;
      vulkan|rocm|cpu) args+=("--$1"); backend_set=1 ;;
      both|gpu) args+=(--both); backend_set=1 ;;
      all-backends|every) args+=(--all-backends); backend_set=1 ;;
      *,*) args+=(--backends "$1"); backend_set=1 ;;
      -*) args+=("$1") ;;
      *) args+=(-m "$1") ;;
    esac
    shift
  done
  printf '%s\n' "${args[@]}"
}

interactive_throughput() {
  local suite backends args pat choice
  suite="$(pick 'Suite:' 'bench (models-bench.ini, default)' 'daily (models.ini sticky)' 'lab (models-lab.ini)' 'all GGUFs')"
  backends="$(pick 'Backends:' 'vulkan' 'rocm' 'cpu' 'vulkan + rocm (both)' 'all three')"
  args=()
  case "$suite" in
    *lab*) args+=(--lab) ;;
    *all*) args+=(--all) ;;
    *daily*) args+=(--daily) ;;
    *) args+=(--bench) ;;
  esac
  case "$backends" in
    vulkan) args+=(--vulkan) ;;
    rocm) args+=(--rocm) ;;
    cpu) args+=(--cpu) ;;
    *all*) args+=(--all-backends) ;;
    *both*) args+=(--both) ;;
    *) args+=(--both) ;;
  esac
  read_tty pat "Model filter (empty = all): "
  if [[ -n "$pat" ]]; then
    IFS=',' read -ra parts <<< "$pat"
    for p in "${parts[@]}"; do
      p="${p// /}"
      [[ -n "$p" ]] && args+=(-m "$p")
    done
  fi
  echo ""
  echo "Preview:"
  "$THROUGHPUT" --list "${args[@]}"
  echo ""
  read_tty choice "Run throughput benchmark? [Y/n]: "
  [[ "${choice:-Y}" =~ ^[Yy]?$ ]] || exit 0
  exec "$THROUGHPUT" "${args[@]}"
}

interactive_sched() {
  local choice model
  echo "=== scheduling (bench-a :11601) ===" >&2
  echo "Stops stickys/lab, uses models-bench.ini, restores after." >&2
  read_tty model "Model [${SCHED_MODEL:-Qwen3.6-35B-A3B-MTP-UD-Q5_K_XL}]: "
  export SCHED_MODEL="${model:-${SCHED_MODEL:-Qwen3.6-35B-A3B-MTP-UD-Q5_K_XL}}"
  read_tty choice "np (slots, need ≥2 for interleave) [${SCHED_NP:-2}]: "
  export SCHED_NP="${choice:-${SCHED_NP:-2}}"
  read_tty choice "ub [${SCHED_UB:-32}]: "
  export SCHED_UB="${choice:-${SCHED_UB:-32}}"
  choice="$(pick 'Run:' 'auto (01+02+03) ~1–2h' 'baseline_solo' 'interleave_np2' 'list scenarios')"
  case "$choice" in
    auto*) exec "$SCHED" --auto ;;
    baseline*) exec "$SCHED" --scenario baseline_solo ;;
    interleave*) exec "$SCHED" --scenario interleave_np2 ;;
    list*) exec "$SCHED" --list ;;
  esac
}

interactive_capacity() {
  local kind="${1:-solo}" models from
  echo "=== capacity (bench-a/b :11601/:11602) ===" >&2
  echo "Sticky INIs are not patched. Stickys are stopped for a clean curve." >&2
  if [[ "$kind" == "help" ]]; then
    [[ -x "$CAPACITY" ]] || chmod +x "$CAPACITY" 2>/dev/null || true
    exec "$CAPACITY" help
  fi
  read_tty from "Sync from [coder,chat,lab]: "
  from="${from:-coder,chat,lab}"
  read_tty models "Models (comma / empty=all; e.g. Tiel-Coder-35B,Qwen3.6-35B): "
  local args=(--from "$from")
  [[ -n "$models" ]] && args+=(--model "$models")
  [[ -x "$CAPACITY" ]] || chmod +x "$CAPACITY" 2>/dev/null || true
  if [[ "$kind" == "dual" ]]; then
    echo "Running: ./bench capacity dual ${args[*]}" >&2
    exec "$CAPACITY" dual "${args[@]}"
  fi
  echo "Running: ./bench capacity kv-ctx ${args[*]}" >&2
  exec "$CAPACITY" kv-ctx "${args[@]}"
}

interactive() {
  local kind
  { echo "=== bench (interactive) ==="
    echo "Pick a goal — you usually do NOT need dual or full matrix."
    echo "Enter = default. Ctrl+C = abort. Cheat sheet: ./bench recipes"
  } >&2
  kind="$(pick 'What do you want?' \
    'A) Fastest model — PP/TG tok/s (~5–30 min)' \
    'B) Sticky feel — np/ub under load (~1–4 h / model)' \
    'C) Max context solo — memory fit (~1–8 h)' \
    'D) Dual 2× servers — optional, needs RAM (~2–12 h)' \
    'E) Code quality — HumanEval' \
    'F) Full matrix — multi-day' \
    'Show recipes cheat sheet')"
  case "$kind" in
    A\)*|*'PP/TG'*) interactive_throughput ;;
    B\)*|*'Sticky feel'*) interactive_sched ;;
    C\)*|*'Max context'*) interactive_capacity solo ;;
    D\)*|*'Dual'*) interactive_capacity dual ;;
    E\)*|*'quality'*|*'HumanEval'*)
      [[ -x "$QUALITY" ]] || chmod +x "$QUALITY" 2>/dev/null || true
      exec "$QUALITY" list
      ;;
    F\)*|*'matrix'*)
      [[ -x "$MATRIX" ]] || chmod +x "$MATRIX" 2>/dev/null || true
      exec "$MATRIX" list
      ;;
    *) print_recipes ;;
  esac
}

cmd="${1:-}"
case "$cmd" in
  ""|i|interactive)
    interactive
    ;;
  recipes|goals|cheat|cheatsheet)
    print_recipes
    ;;
  help|-h|--help)
    usage
    echo ""
    echo "--- throughput ---"
    "$THROUGHPUT" --help
    echo ""
    echo "--- scheduling ---"
    "$SCHED" --help
    echo ""
    echo "--- quality ---"
    [[ -x "$QUALITY" ]] || chmod +x "$QUALITY" 2>/dev/null || true
    "$QUALITY" help
    echo ""
    echo "--- capacity ---"
    [[ -x "$CAPACITY" ]] || chmod +x "$CAPACITY" 2>/dev/null || true
    "$CAPACITY" help
    echo ""
    echo "--- matrix ---"
    [[ -x "$MATRIX" ]] || chmod +x "$MATRIX" 2>/dev/null || true
    "$MATRIX" help
    ;;
  quality|q)
    shift
    [[ -x "$QUALITY" ]] || chmod +x "$QUALITY" 2>/dev/null || true
    chmod +x "$ROOT"/tools/bench/quality/plugins/*/run.sh 2>/dev/null || true
    exec "$QUALITY" "$@"
    ;;
  capacity|cap)
    shift
    [[ -x "$CAPACITY" ]] || chmod +x "$CAPACITY" 2>/dev/null || true
    chmod +x "$ROOT"/tools/bench/capacity/scenarios/*.sh 2>/dev/null || true
    exec "$CAPACITY" "$@"
    ;;
  halogen|halo)
    shift
    [[ -x "$HALOGEN" ]] || chmod +x "$HALOGEN" 2>/dev/null || true
    chmod +x "$ROOT"/tools/bench/halogen/*.sh "$ROOT"/tools/bench/halogen/lib/*.sh 2>/dev/null || true
    exec "$HALOGEN" "$@"
    ;;
  matrix|m)
    shift
    [[ -x "$MATRIX" ]] || chmod +x "$MATRIX" 2>/dev/null || true
    exec "$MATRIX" "$@"
    ;;
  sync-models|sync_models|models-sync)
    shift
    [[ -x "$SYNC_MODELS" ]] || chmod +x "$SYNC_MODELS" 2>/dev/null || true
    exec "$SYNC_MODELS" "$@"
    ;;
  smoke)
    shift
    [[ -x "$SMOKE" ]] || chmod +x "$SMOKE" 2>/dev/null || true
    exec "$SMOKE" "$@"
    ;;
  audio|tts|stt)
    shift
    [[ -x "$AUDIO" ]] || chmod +x "$AUDIO" 2>/dev/null || true
    exec "$AUDIO" "$@"
    ;;
  publish)
    [[ -x "$PUBLISH_DOCS" ]] || chmod +x "$PUBLISH_DOCS" 2>/dev/null || true
    exec "$PUBLISH_DOCS"
    ;;
  probe-host|host)
    PROBE="$ROOT/tools/bench/probe-host.sh"
    [[ -x "$PROBE" ]] || chmod +x "$PROBE" 2>/dev/null || true
    exec "$PROBE"
    ;;
  throughput|thr|t)
    shift
    if [[ $# -eq 0 ]]; then
      interactive_throughput
    elif [[ "${1:-}" == -* ]]; then
      exec "$THROUGHPUT" "$@"
    else
      mapfile -t mapped < <(map_shorthand "$@")
      exec "$THROUGHPUT" "${mapped[@]}"
    fi
    ;;
  sched|scheduling|s)
    shift
    exec "$SCHED" "$@"
    ;;
  list|ls)
    shift
    mapfile -t mapped < <(map_shorthand "$@")
    exec "$THROUGHPUT" --list "${mapped[@]}"
    ;;
  compare)
    exec "$THROUGHPUT" --compare
    ;;
  compare-run|latest)
    exec "$THROUGHPUT" --compare-run
    ;;
  compare-sched)
    exec "$SCHED" --compare
    ;;
  apply-ini)
    shift
    [[ -x "$APPLY_INI" ]] || chmod +x "$APPLY_INI" 2>/dev/null || true
    exec "$APPLY_INI" "$@"
    ;;
  index)
    [[ -x "$BUILD_INDEX" ]] || chmod +x "$BUILD_INDEX" 2>/dev/null || true
    exec "$BUILD_INDEX"
    ;;
  run)
    # legacy: pass through to throughput
    shift
    exec "$THROUGHPUT" "$@"
    ;;
  *)
    # legacy shorthand (no subcommand) → throughput
    if [[ "$cmd" == -* ]]; then
      exec "$THROUGHPUT" "$@"
    fi
    mapfile -t mapped < <(map_shorthand "$@")
    exec "$THROUGHPUT" "${mapped[@]}"
    ;;
esac
