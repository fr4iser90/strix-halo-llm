# Local overrides (copy to .env — gitignored).
# Compose reads this automatically from the project directory.

# Embedded llama-server Web UI at http://host:PORT/
# true  = UI on (default, good for forks / quick chat)
# false = API-only (--no-webui); use with CLI / gateway
LLAMA_WEBUI=true

# Host sidecar (Docker) — GPU watts + thermal during benches (off by default).
#   cd sidecar && docker compose up -d --build
#
# Minimal (uses :9105 defaults):
#   GPU_POWER=true
#
# Custom port / host only when needed:
#   GPU_POWER=true
#   SOURCE_SIDECAR_PORT=9105
#   SOURCE_SIDECAR_HOST=127.0.0.1
#   GPU_POWER_URL=http://127.0.0.1:9105/power      # optional override
#   GPU_THERMAL_URL=http://127.0.0.1:9105/thermal  # optional override
#
# Sidecar down while enabled → watts stay empty (bench continues).
GPU_POWER=false
