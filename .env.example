# Local overrides (copy to .env — gitignored).
# Used by: ./stack · ./bench · engines/*/compose.yaml

# ── Default home stack: Halogen Flash + embeddings + TTS + STT ─────────
# (no llama sticky chat / coder)
STACK_ENGINES=halogen,llama,piper,whisper
LLAMA_SERVICES=llama-embeddings
# After benches: restore embeddings only (not sticky/coder)
LLAMA_DAILY_SERVICES=llama-embeddings
# Full llama sticky+coder instead: unset LLAMA_SERVICES, set STACK_ENGINES=llama,…
# LLAMA_PROFILES=rag

# ── Weights ────────────────────────────────────────────────────────────
MODELS_ROOT=./models
MODELS_DIR=./models/gguf
TTS_MODELS=./models/tts
STT_MODELS=./models/stt
# Jarvis:
# MODELS_ROOT=/home/Jarvis/data/models
# MODELS_DIR=/home/Jarvis/data/models/gguf
# TTS_MODELS=/home/Jarvis/data/models/tts
# STT_MODELS=/home/Jarvis/data/models/stt
HALOGEN_MODELS=./models/hgn/qwen38flash
# HALOGEN_MODELS=/home/Jarvis/data/models/hgn/qwen38flash

# ── llama.cpp (embeddings only in default stack; Vulkan) ───────────────
LLAMA_WEBUI=true

# ── Halogen Flash (:8731) ──────────────────────────────────────────────
# HALOGEN_GROUP_ADD=video

# ── Gufo (:8080) — allowlisted models only (engines/gufo/MODELS.md) ────
# GUFO_MODELS=./models/gguf
# GUFO_MODEL=/models/chat/large/Qwen3.8-27B-UD-Q8_K_XL.gguf
# GUFO_SPECULATIVE=dflash2
# GUFO_DFLASH_MODEL=/models/chat/large/Qwen3.8-27B-DFlash2-Q4_K_M.gguf
# GUFO_PUBLISH_PORT=8080

# ── Piper TTS (:9001) / whisper STT (:9000) ────────────────────────────
# PIPER_DEFAULT_VOICE=de_DE-thorsten-high
# WHISPER_MODEL=ggml-large-v3.bin

# ── Bench ──────────────────────────────────────────────────────────────
GPU_POWER=false
# BENCH_ENGINE_SKIP_LIFECYCLE=1
SMOKE_ENGINES=halogen,piper,whisper
