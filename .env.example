# Optional overrides (copy to .env — gitignored).
# Without .env, defaults still apply:
#   MODELS_ROOT = ~/data/models  (if that directory exists) else ./models
#   STACK_ENGINES = gufo,llama,piper,whisper + LLAMA_SERVICES=llama-embeddings
# Used by: ./stack · ./bench · engines/*/compose.yaml when present.

# ── Default home stack: Gufo Flash-Next Q4 + embeddings + TTS + STT ────
STACK_ENGINES=gufo,llama,piper,whisper
LLAMA_SERVICES=llama-embeddings
# Restore after benches = what was running before stop (snapshot). Optional override:
# LLAMA_DAILY_SERVICES=llama-embeddings

# ── Weights (optional — omit to use ~/data/models auto-default) ────────
# MODELS_ROOT=/home/Jarvis/data/models
# MODELS_DIR=/home/Jarvis/data/models/gguf
# TTS_MODELS=/home/Jarvis/data/models/tts
# STT_MODELS=/home/Jarvis/data/models/stt
# HALOGEN_MODELS=/home/Jarvis/data/models/hgn/qwen38flash

# ── llama.cpp ──────────────────────────────────────────────────────────
LLAMA_WEBUI=true

# ── Halogen Flash (:8731) — optional Lab / compare ─────────────────────
# HALOGEN_GROUP_ADD=video

# ── Gufo (:8080) — default daily LLM (Flash-Next Q4 @ 262k) ───────────
# GUFO_MODELS=/home/Jarvis/data/models/gguf
GUFO_MODEL=/models/chat/large/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf
GUFO_CONTEXT=262144
GUFO_SESSIONS=4
GUFO_EXTRA_ARGS=--context 262144
# Optional MTP (Flash-Next) / DFlash2 (27B) — leave unset for plain AR:
# GUFO_SPECULATIVE=…
# GUFO_DFLASH_MODEL=/models/chat/large/…

# ── Piper / whisper ────────────────────────────────────────────────────
# PIPER_DEFAULT_VOICE=de_DE-thorsten-high
# WHISPER_MODEL=ggml-large-v3.bin

# ── Bench ──────────────────────────────────────────────────────────────
GPU_POWER=false
SMOKE_ENGINES=gufo,piper,whisper
