# Optional overrides (copy to .env — gitignored).
# Without .env, defaults still apply:
#   MODELS_ROOT = ~/data/models  (if that directory exists) else ./models
#   STACK_ENGINES = halogen,llama,piper,whisper + LLAMA_SERVICES=llama-embeddings
# Used by: ./stack · ./bench · engines/*/compose.yaml when present.

# ── Default home stack: Halogen Flash + embeddings + TTS + STT ─────────
STACK_ENGINES=halogen,llama,piper,whisper
LLAMA_SERVICES=llama-embeddings
LLAMA_DAILY_SERVICES=llama-embeddings
# Full llama sticky+coder: unset LLAMA_SERVICES, STACK_ENGINES=llama,…

# ── Weights (optional — omit to use ~/data/models auto-default) ────────
# MODELS_ROOT=/home/Jarvis/data/models
# MODELS_DIR=/home/Jarvis/data/models/gguf
# TTS_MODELS=/home/Jarvis/data/models/tts
# STT_MODELS=/home/Jarvis/data/models/stt
# HALOGEN_MODELS=/home/Jarvis/data/models/hgn/qwen38flash

# ── llama.cpp ──────────────────────────────────────────────────────────
LLAMA_WEBUI=true

# ── Halogen Flash (:8731) ──────────────────────────────────────────────
# HALOGEN_GROUP_ADD=video

# ── Gufo (:8080) — allowlist: engines/gufo/MODELS.md ───────────────────
# GUFO_MODEL=/models/chat/large/Qwen3.8-27B-UD-Q8_K_XL.gguf
# GUFO_SPECULATIVE=dflash2
# GUFO_DFLASH_MODEL=/models/chat/large/Qwen3.8-27B-DFlash2-Q4_K_M.gguf

# ── Piper / whisper ────────────────────────────────────────────────────
# PIPER_DEFAULT_VOICE=de_DE-thorsten-high
# WHISPER_MODEL=ggml-large-v3.bin

# ── Bench ──────────────────────────────────────────────────────────────
GPU_POWER=false
SMOKE_ENGINES=halogen,piper,whisper
